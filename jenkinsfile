pipeline {
    agent any



    stages {
        stage("BUILD-STAGE") {
            steps {
                sh 'echo Building project...'
               
            }
        }

        stage("TEST-STAGE") {
            steps {
                sh 'echo Testing project...'
            }
        }

        stage("DEPLOY-STAGE") {
            steps {
                sh 'echo Deploying project...'
            }
        }
    }

    post {
        always {
            echo "THANK YOU"
        }
    }
}
